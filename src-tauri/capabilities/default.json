{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window APIs plus the VocaTechX backend commands, for the main window only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-session",
    "allow-login",
    "allow-logout",
    "allow-change-password",
    "allow-get-system-overview",
    "allow-get-recent-activity",
    "allow-get-system-status",
    "allow-ralp-status",
    "allow-ralp-start",
    "allow-ralp-import-model",
    "allow-ralp-list-conversations",
    "allow-ralp-get-messages",
    "allow-ralp-delete-conversation",
    "allow-ralp-send-message",
    "allow-ralp-stop-generation",
    "allow-net-health",
    "allow-net-adapters",
    "allow-net-run-diagnostics",
    "allow-net-dns-lookup",
    "allow-net-repair",
    "allow-net-open-settings",
    "allow-net-performance-test",
    "allow-net-sharing-overview",
    "allow-net-discover-computers",
    "allow-net-list-shares",
    "allow-net-check-smb",
    "allow-net-test-share-access",
    "allow-net-open-share",
    "allow-net-pick-folder",
    "allow-net-create-share",
    "allow-net-remove-share",
    "allow-net-history",
    "allow-net-report",
    "allow-net-export-report",
    "allow-net-wifi-password",
    "allow-dev-printers",
    "allow-dev-spooler-status",
    "allow-dev-print-jobs",
    "allow-dev-devices",
    "allow-dev-drivers",
    "allow-dev-open-printer-settings",
    "allow-dev-open-printer-window",
    "allow-dev-open-device-manager",
    "allow-dev-open-device-properties",
    "allow-dev-history",
    "allow-dev-report",
    "allow-dev-export-report"
  ]
}
